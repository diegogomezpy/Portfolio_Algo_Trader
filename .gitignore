.env
.env.paper
.env.live
.cred_kek          # Fernet key for the encrypted per-account credential store (engine.credstore)

# Regenerable / large artifacts
data/
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

