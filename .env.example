# Template for .env.paper and .env.live — copy to one of those and fill in.
# NEVER commit real credentials. .env.paper / .env.live are git-ignored.

# Alpaca API credentials (paper or live key pair, matched to ALPACA_BASE_URL)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca endpoints
#   paper: https://paper-api.alpaca.markets
#   live:  https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# PostgreSQL operational store
DATABASE_URL=postgresql://user:pass@localhost:5432/sharpe_engine

# Email alerting (Phase 5)
SMTP_PASSWORD=

# No Bloomberg API or FMP key needed — yfinance handles fundamentals.
