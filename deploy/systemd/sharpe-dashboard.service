[Unit]
# sharpe-engine dashboard (FastAPI/uvicorn). Bound to localhost ONLY — the app itself has
# no auth; public access goes through Caddy (basic auth, :8080) + Tailscale Funnel. Never
# open a firewall rule straight to :8000.
Description=sharpe-engine dashboard (paper)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python scripts/run_dashboard.py --env paper --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
